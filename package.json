{
  "name": "@cyn1151/common-components",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A React component library",
  "main": "./dist/common-components.umd.js",
  "module": "./dist/common-components.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/common-components.es.js",
      "require": "./dist/common-components.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "storybook": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "eslint-plugin-storybook": "^10.6.7",
    "vitest": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest"
  }
}
